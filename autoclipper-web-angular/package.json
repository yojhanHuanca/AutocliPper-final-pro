{
  "name": "autoclipper-web-angular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host localhost --port 4200",
    "build": "ng build",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "contracts": "node scripts/contracts/generate.mjs",
    "contracts:sync": "node scripts/contracts/generate.mjs --sync",
    "contracts:check": "node scripts/contracts/generate.mjs --check-upstream",
    "test": "node scripts/test-unit.mjs",
    "test:live": "node --test tests/live/workflow.test.mjs"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
