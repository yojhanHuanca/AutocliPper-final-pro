  "info": {
    "title": "AutoClipper project-service",
    "description": "",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "PutUploadIntentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "put"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Temporary capability URL; expires after five minutes."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 300
          }
        },
        "required": [
          "id",
          "mode",
          "url",
          "headers",
          "expiresInSeconds"
        ]
      },
      "MultipartUploadIntentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "multipart"
            ]
          },
          "partBytes": {
            "type": "number",
            "example": 8388608
          },
          "parts": {
            "type": "number"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "mode",
          "partBytes",
          "parts",
          "expiresAt"
        ]
      },
      "ProjectDto": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 150
          }
        },
        "required": [
          "workspaceId",
          "name"
        ]
      },
      "CreatedProjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "ProjectSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "number",
            "minimum": 1
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "version",
          "workspaceId",
          "name",
          "createdAt"
        ]
      },
      "ProjectListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSummaryDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ProjectResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "number",
            "minimum": 1
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "workspaceId",
          "name"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "version": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "version"
        ]
      },
      "UploadDto": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "number",
            "minimum": 1,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/webm",
              "video/quicktime",
              "video/x-matroska"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "put",
              "multipart"
            ],
            "default": "put"
          }
        },
        "required": [
          "bytes",
          "sha256",
          "contentType",
          "mode"
        ]
      },
      "PartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "partNumber",
          "sha256"
        ]
      },
      "SignedPartDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "bytes": {
            "type": "number",
            "description": "Exact size of this part, in bytes."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 300
          }
        },
        "required": [
          "url",
          "bytes",
          "headers",
          "expiresInSeconds"
        ]
      },
      "ConfirmedUploadDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "confirmed"
            ]
          }
        },
        "required": [
          "id",
          "state"
        ]
      },
      "MetadataDto": {
        "type": "object",
        "properties": {
          "durationSeconds": {
            "type": "number",
            "description": "Measured duration in seconds."
          },
          "format": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "videoCodec": {
            "type": "string"
          },
          "audioCodec": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "durationSeconds",
          "format",
          "width",
          "height",
          "videoCodec",
          "audioCodec"
        ]
      },
      "InspectionDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "result": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/MetadataDto"
              }
            ]
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "attempts": {
            "type": "number"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "status"
        ]
      },
      "UploadStatusDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "aborted"
            ]
          },
          "bytes": {
            "type": "number",
            "description": "Declared and confirmed object size in bytes."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "inspection": {
            "$ref": "#/components/schemas/InspectionDto"
          }
        },
        "required": [
          "id",
          "projectId",
          "state",
          "bytes",
          "expiresAt"
        ]
      }
    }
  }
}
