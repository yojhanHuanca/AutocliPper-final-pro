  "info": {
    "title": "AutoClipper identity-service",
    "description": "",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "GoogleChallengeDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "sign_in",
              "link"
            ]
          }
        },
        "required": [
          "purpose"
        ]
      },
      "GoogleCredentialDto": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "string",
            "minLength": 20,
            "maxLength": 12000
          },
          "factor": {
            "type": "string",
            "description": "TOTP or one-use recovery code if enabled."
          }
        },
        "required": [
          "credential"
        ]
      },
      "LinkGoogleDto": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "string",
            "minLength": 20,
            "maxLength": 12000
          },
          "factor": {
            "type": "string",
            "description": "TOTP or one-use recovery code if enabled."
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "credential",
          "password"
        ]
      },
      "MfaStatusResponseDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "recoveryCodesRemaining": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "enabled",
          "recoveryCodesRemaining"
        ]
      },
      "PasswordProofDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ]
      },
      "MfaSetupResponseDto": {
        "type": "object",
        "properties": {
          "otpauthUri": {
            "type": "string",
            "format": "uri",
            "description": "Sensitive authenticator enrollment URI; never log or persist in the browser."
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 600
          }
        },
        "required": [
          "otpauthUri",
          "expiresInSeconds"
        ]
      },
      "EnableMfaDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "password",
          "code"
        ]
      },
      "MfaEnabledResponseDto": {
        "type": "object",
        "properties": {
          "recoveryCodes": {
            "description": "Displayed once. Store offline; each code is accepted only once.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "recoveryCodes",
          "enabled"
        ]
      },
      "FactorProofDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "factor": {
            "type": "string",
            "description": "TOTP or one-use recovery code."
          }
        },
        "required": [
          "password"
        ]
      },
      "RequiredFactorProofDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "factor": {
            "type": "string"
          }
        },
        "required": [
          "password",
          "factor"
        ]
      },
      "RecoveryCodesResponseDto": {
        "type": "object",
        "properties": {
          "recoveryCodes": {
            "description": "Displayed once. Store offline; each code is accepted only once.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "recoveryCodes"
        ]
      },
      "PreferencesResponseDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "es",
              "en"
            ]
          },
          "timezone": {
            "type": "string",
            "example": "America/Lima"
          },
          "emailNotifications": {
            "type": "boolean"
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ]
          }
        },
        "required": [
          "locale",
          "timezone",
          "emailNotifications",
          "theme"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "preferences": {
            "$ref": "#/components/schemas/PreferencesResponseDto"
          },
          "version": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "preferences",
          "version"
        ]
      },
      "PreferencesDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "es",
              "en"
            ]
          },
          "timezone": {
            "type": "string",
            "example": "America/Lima"
          },
          "emailNotifications": {
            "type": "boolean"
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ]
          }
        }
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "preferences": {
            "$ref": "#/components/schemas/PreferencesDto"
          },
          "version": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "version"
        ]
      },
      "PrivacyRequestDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "factor": {
            "type": "string",
            "description": "TOTP or one-use recovery code."
          },
          "kind": {
            "type": "string",
            "enum": [
              "export",
              "deletion"
