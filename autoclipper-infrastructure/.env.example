# Generate actual random local credentials with: node setup-local.mjs
# This file deliberately has no usable passwords. Never use development credentials in production.
POSTGRES_ADMIN_PASSWORD=
MEDIA_OWNER_PASSWORD=
MEDIA_RUNTIME_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
INTERNAL_TOKEN=
IDENTITY_OWNER_PASSWORD=
IDENTITY_RUNTIME_PASSWORD=
WORKSPACE_OWNER_PASSWORD=
WORKSPACE_RUNTIME_PASSWORD=
PROJECT_OWNER_PASSWORD=
PROJECT_RUNTIME_PASSWORD=
ANALYSIS_OWNER_PASSWORD=
ANALYSIS_RUNTIME_PASSWORD=
# Automatic clip selection defaults to OpenAI. Gemini is an explicit paid alternative. Ollama is unsupported.
AI_ANALYSIS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_INPUT_USD_PER_MILLION_TOKENS=0.10
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=0.50
# Optional Gemini selector. Keep empty unless Gemini is selected and its exact model prices are reviewed.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INPUT_USD_PER_MILLION_TOKENS=
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=
# Paid selection is fail-closed; configure these only after approving per-job spend.
PAID_AI_ENABLED=false
AI_MAX_ESTIMATED_USD_PER_JOB=0
# Paid OpenAI calls require a unique run UUID and a Redis-backed cap from 1 to 5.
OPENAI_MAX_API_INVOCATIONS_PER_RUN=0
OPENAI_INVOCATION_BUDGET_ID=
AUTH_ENCRYPTION_KEY=
CSRF_SIGNING_KEY=
GOOGLE_CLIENT_ID=
# Server-only YouTube Data API v3 key for metadata lookup. Never put this in browser config.
YOUTUBE_DATA_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3005/v1/auth/twitch/callback
# Server-only gate: development allows manual jobs; commercial requires pipelines.
PROCESSING_ADMISSION_MODE=development
# No-cost local development allowance, assigned on the first reservation; not a commercial plan.
DEV_PROCESSING_SECONDS_PER_MONTH=3600
DEV_ACTIVE_PIPELINES=4
